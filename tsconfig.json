{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    // ES2015 built-ins only: esbuild down-levels syntax but doesn't polyfill
    // APIs, so newer ones (e.g. Array.prototype.includes) would break the
    // browsers listed under "Browser Support" in the README
    "lib": ["ES2015", "DOM", "DOM.Iterable"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "tests"]
}
